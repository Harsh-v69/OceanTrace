# Copy to .env and adjust. Every value has a safe default; nothing here is
# required for the app to boot.

# --- application ---
ENV=development
DEBUG=true
APP_VERSION=0.2.0

# --- offline-first / modes ---
OFFLINE_MODE=true
ML_LAZY_LOAD=true
SMS_PROVIDER=mock            # mock | twilio

# --- server ---
HOST=127.0.0.1
PORT=8000
# "*" or a comma-separated list of origins
CORS_ORIGINS=*

# --- database ---
# SQLite by default. For PostGIS later:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/oilspill
DATABASE_URL=sqlite:///./data/app.db
DATABASE_ECHO=false

# --- auth / jwt ---
# CHANGE THIS in any non-local deployment.
JWT_SECRET_KEY=dev-insecure-secret-change-me-please-0000000000000000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALLOW_REGISTRATION_ROLE_SELECT=true
# Epic 1: hierarchical user management. Keep open self-registration OFF in any
# real deployment - a NATIONAL/REGIONAL admin creates accounts via POST /users.
ALLOW_OPEN_REGISTRATION=false
# Idempotently seed one account per role at startup:
#   national@oceantrace.gov.in / regional@oceantrace.gov.in / pilot@oceantrace.gov.in
SEED_DEFAULT_USERS=true
DEFAULT_USER_PASSWORD=ChangeMe!OceanTrace1

# --- twilio (only when SMS_PROVIDER=twilio; requires `pip install twilio`) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- alerting ---
ALERT_CONFIDENCE_THRESHOLD=0.75
# Dedup: two alerts sharing a fingerprint (location grid + time bucket +
# geometry signature) inside the cooldown collapse into one.
ALERT_DEDUP_COOLDOWN_MINUTES=180
ALERT_DEDUP_GRID_DEG=0.05
ALERT_DEDUP_TIME_BUCKET_MINUTES=60
ALERT_MAX_SEND_ATTEMPTS=3

# --- jurisdictions ---
# Seed the demo Indian maritime zones (national + 4 regions + 9 coastal states)
# at startup. Idempotent.
SEED_DEMO_JURISDICTIONS=true
